# env.sh - Machine-specific environment variables and secrets
# Copy this file to env.sh and fill in your values.

# --- Personal constants ---
# The directory `backup` mirrors to the external drives
export JONATHAN_HOME="$HOME/Dropbox"
export IMAGE_LONG_EDGE_SIZE=5400
export SHOW_QUOTE=true
# Set to true on a work machine to enable the `claude-personal` alias
export IS_WORK_COMPUTER=false

# --- OpenAI ---
export OPENAI_API_KEY='your_openai_api_key'

# --- GitHub ---
export GITHUB_TOKEN=your_github_token

# --- PATH additions ---
export PATH="$HOME/.local/bin:$PATH"

# --- Work functions ---
# myWorkFunc()
